{
  "name": "SyncVision",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "dev:web": "turbo dev --filter=@SyncVision/web",
    "dev:signaling": "turbo dev --filter=@SyncVision/signaling",
    "dev:all": "turbo dev --parallel"
  },
  "devDependencies": {
    "turbo": "^2.3.0"
  },
  "packageManager": "npm@10.0.0"
}
