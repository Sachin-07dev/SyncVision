# ── Database ──────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/exceliboard

# ── Auth ──────────────────────────────────────
JWT_SECRET=change-me-to-a-secure-random-string
JWT_EXPIRES_IN=7d

# ── Server ────────────────────────────────────
PORT=3001
CLIENT_URL=http://localhost:8080

# ── WebRTC Signaling ─────────────────────────
SIGNALING_PORT=3002
